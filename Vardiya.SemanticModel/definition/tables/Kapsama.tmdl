table Kapsama
	lineageTag: 00594e7b-afc7-4873-bc0c-8d88d872f508

	measure 'İhtiyaç satırı' = COUNTROWS(Kapsama)
		formatString: #,0
		lineageTag: 0da80c71-5684-44d9-ba3f-745b79a63557

	measure 'Mevcut açık' = COALESCE(COUNTROWS(FILTER(Kapsama, Kapsama[Mevcut] < Kapsama[Gerekli])), 0)
		formatString: #,0
		lineageTag: 15472df5-74f1-4ac2-b084-767ae679ce76

	measure 'Tam sınırda' = COALESCE(COUNTROWS(FILTER(Kapsama, Kapsama[Mevcut] = Kapsama[Gerekli])), 0)
		formatString: #,0
		lineageTag: 8b9b75b0-ebde-44ac-abeb-6b5b6e15650d

	measure Yedekli = [İhtiyaç satırı] - [Mevcut açık] - [Tam sınırda]
		formatString: #,0
		lineageTag: 80f799ea-fd72-4bcf-bef6-96e284dd252d

	measure 'Karşılama oranı' = DIVIDE([İhtiyaç satırı] - [Mevcut açık], [İhtiyaç satırı])
		formatString: 0.0%
		lineageTag: a2d85afb-85c5-4563-8e01-1e532194a723

	measure 'Yeni açık' =
			VAR Kisi = SELECTEDVALUE(IzinSecimi[KisiID])
			RETURN
			    IF(NOT ISBLANK(Kisi), COALESCE(CALCULATE(SUM(Katki[Kritik]), TREATAS({Kisi}, Katki[KisiID])), 0))
		formatString: #,0
		lineageTag: 4d320562-8b18-46b8-a12c-f9aa350d56a5

	measure 'Yedeğini kaybeden' =
			VAR Kisi = SELECTEDVALUE(IzinSecimi[KisiID])
			RETURN
			    IF(NOT ISBLANK(Kisi), COALESCE(CALCULATE(SUM(Katki[Yedek]), TREATAS({Kisi}, Katki[KisiID])), 0))
		formatString: #,0
		lineageTag: 8c53d7f0-b302-4695-9c52-fddc64a85ede

	measure 'İzin sonrası açık' = IF(HASONEVALUE(IzinSecimi[KisiID]), [Mevcut açık] + [Yeni açık])
		formatString: #,0
		lineageTag: 7821e9dd-94bc-4ad3-8bbb-f08513fc26d9

	measure 'Senaryo başlığı' = IF(HASONEVALUE(IzinSecimi[KisiID]), SELECTEDVALUE(IzinSecimi[Çalışan]) & " izne çıkarsa ne değişir?", "İzin etkisini görmek için bir çalışan seçin")
		lineageTag: b05111d0-0440-46d3-bb61-049ed47895f3

	measure 'Plan başlığı' = SELECTEDVALUE(Hat[Tesis], "Tüm tesisler") & " | Vardiya planı talebi karşılıyor mu?"
		lineageTag: 35a8442f-8d79-4ae4-905a-373647d1e76d

	measure 'Destek önerisi' = IF([Yeni açık] = 1 && [İhtiyaç satırı] = 1, COALESCE(SELECTEDVALUE(Kapsama[Destek adayı]), "Uygun aday yok"))
		lineageTag: e52ceb9c-afd6-4408-8da4-4d8f9c7bedfc

	column GunID
		dataType: int64
		isHidden
		lineageTag: a1947ba6-1ecd-4ec9-b661-fd86f2159741
		summarizeBy: none
		sourceColumn: GunID

	column HatID
		dataType: int64
		isHidden
		lineageTag: d30bfb80-558c-4075-a3f1-de86cd0f2293
		summarizeBy: none
		sourceColumn: HatID

	column VardiyaID
		dataType: int64
		isHidden
		lineageTag: e7cbef55-15b4-4191-9581-e123982f9ad3
		summarizeBy: none
		sourceColumn: VardiyaID

	column YetkiID
		dataType: int64
		isHidden
		lineageTag: 25ae3483-40b9-4077-b207-800c1347de3c
		summarizeBy: none
		sourceColumn: YetkiID

	column Gerekli
		dataType: int64
		lineageTag: f55056a1-028c-4d8b-a2cb-bd1e9ce5f427
		summarizeBy: none
		sourceColumn: Gerekli

	column Mevcut
		dataType: int64
		lineageTag: 124d4097-2aba-4332-a9a1-bf9618bd31d3
		summarizeBy: none
		sourceColumn: Mevcut

	column 'Destek adayı'
		dataType: string
		lineageTag: 058db83f-d018-4aa5-9ab0-14f4aa4578d2
		summarizeBy: none
		sourceColumn: Destek adayı

	partition Kapsama = m
		mode: import
		source =
				let
				    Csv = Csv.Document(Binary.Decompress(Binary.FromText(Text.Combine({"", "", "", "", ""}), BinaryEncoding.Base64), Compression.GZip), [Delimiter=";", Encoding=65001]),
				    Headers = Table.PromoteHeaders(Csv),
				    Typed = Table.TransformColumnTypes(Headers, {{"GunID", Int64.Type}, {"HatID", Int64.Type}, {"VardiyaID", Int64.Type}, {"YetkiID", Int64.Type}, {"Gerekli", Int64.Type}, {"Mevcut", Int64.Type}, {"Destek adayı", type text}}, "en-US")
				in Typed

